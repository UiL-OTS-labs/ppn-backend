msgid "leaders:forms:create_form:is_primary:help_text"
msgstr ""
"If checked, this user will be marked as the primary leader. This will "
"require a phone number."

#: leaders/forms.py:64 leaders/forms.py:129
msgid "leaders:forms:create_form:notify_user:label"
msgstr "Notify user"

#: leaders/forms.py:65
msgid "leaders:forms:create_form:notify_user:help_text"
msgstr ""
"If checked, the system will sent out an email to this user informing them of "
"their new account. If no password was set, this email will contain "
"instructions on how to set a password on their own."

msgid "leaders:forms:create_form:phone:help_text"
msgstr "If phonenumber is left blank, this user cannot be registered as primary leader on an experiment. However, this user can still be added as additional leader"

